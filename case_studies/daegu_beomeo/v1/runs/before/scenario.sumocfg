<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="../../network/beomeo.net.xml" />
    <route-files value="../../data/before.rou.xml" />
    <additional-files value="measurements.add.xml,../../network/beomeo.poly.xml" />
  </input>
  <time>
    <begin value="0" />
    <end value="2100" />
    <step-length value="0.5" />
  </time>
  <processing>
    <time-to-teleport value="-1" />
    <collision.action value="warn" />
  </processing>
  <report>
    <no-step-log value="true" />
    <duration-log.statistics value="true" />
  </report>
  <output>
    <fcd-output value="fcd.xml.gz" />
    <tripinfo-output value="tripinfo.xml" />
    <tripinfo-output.write-unfinished value="true" />
    <summary-output value="summary.xml" />
    <statistic-output value="statistics.xml" />
  </output>
  <fcd_device>
    <device.fcd.period value="2" />
  </fcd_device>
  <random_number>
    <seed value="2026" />
  </random_number>
</configuration>